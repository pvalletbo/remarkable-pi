{
  "name": "remarkable-pi",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only, local reMarkable PDF bridge for pi agent sessions",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "keywords": [
    "pi-package",
    "remarkable",
    "local-first"
  ],
  "bin": {
    "remarkable-pi": "./dist/cli.js"
  },
  "pi": {
    "extensions": [
      "./extensions/remarkable.ts"
    ]
  },
  "scripts": {
    "build": "bun run --bun tsc -p tsconfig.build.json",
    "check": "bun run --bun tsc --noEmit",
    "test": "bun run build && bun test --timeout 30000",
    "test:pi-node": "bun run build && REMARKABLE_PI_TEST_PI_RUNTIME=node bun test test/pi-integration.test.ts --timeout 30000",
    "dev": "bun run build && bun src/cli.ts",
    "demo": "bun run build && bun scripts/demo.ts",
    "verify": "bun run build && bun run check && bun test --timeout 30000"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.9",
    "effect": "4.0.0-rc.118",
    "pdfjs-dist": "6.3.289"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@types/bun": "1.4.2",
    "typescript": "^5.9.0"
  }
}
